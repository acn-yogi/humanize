# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.coverage
.coverage.*
coverage.xml
.hypothesis/

# Translations
*.mo

# Logs
*.log

# Environments
.env

# mkdocs documentation
/site
node_modules/

# mypy
.dmypy.json
dmypy.json

# PyCharm
.idea/

# hatch-vcs
src/*/_version.py

# Workbench demo: local run output (recordings live in demo/recordings; an archived run's
# records under demo/live-runs/<date>/runs/ are kept, so only the top-level folder is ignored)
/runs/
# The recordings keep their console and check logs: the replay fallback reads them.
!demo/recordings/**/*.log
# The demo's live feed is rewritten on every run; the schema, validator and archived runs are kept.
demo/live/*
!demo/live/schema.json
!demo/live/validate.py
!demo/live/README.md
!demo/live-runs/**/*.log
runs/lessons.jsonl
