+@pytest.mark.parametrize(
+    "val, kwargs, expected",
+    [
+        (dt.timedelta(seconds=-3661), {}, "-1 hour, 1 minute and 1 second"),
+        (-3661, {}, "-1 hour, 1 minute and 1 second"),
+        (dt.timedelta(seconds=-1), {}, "-1 second"),
+        (dt.timedelta(days=-2, seconds=-33), {}, "-2 days and 33 seconds"),
+        (
+            dt.timedelta(days=-2, seconds=-3633, microseconds=-123000),
+            {"suppress": ["days"]},
+            "-49 hours and 33.12 seconds",
+        ),
+        (
+            dt.timedelta(microseconds=-1001),
+            {"minimum_unit": "microseconds"},
+            "-1 millisecond and 1 microsecond",
+        ),
+        (
+            dt.timedelta(microseconds=-2002),
+            {"minimum_unit": "milliseconds", "format": "%0.4f"},
+            "-2.0020 milliseconds",
+        ),
+        (dt.timedelta(seconds=-1), {"minimum_unit": "minutes"}, "-0.02 minutes"),
+        # Zero never gains a sign, even when the value rounds down to zero
+        (dt.timedelta(0), {}, "0 seconds"),
+        (0, {}, "0 seconds"),
+        (-0.0, {}, "0 seconds"),
+        (dt.timedelta(seconds=-0.1), {"minimum_unit": "minutes"}, "0 minutes"),
+    ],
+)
+def test_precisedelta_negative(
+    val: dt.timedelta | float, kwargs: dict[str, typing.Any], expected: str
+) -> None:
+    assert humanize.precisedelta(val, **kwargs) == expected
