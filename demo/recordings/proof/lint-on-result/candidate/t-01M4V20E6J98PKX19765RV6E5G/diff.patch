     >>> precisedelta(delta, minimum_unit="minutes")
     '0 minutes'
 
+    ```
+
+    A negative value keeps its sign:
+
+    ```pycon
+    >>> precisedelta(dt.timedelta(seconds=-3661))
+    '-1 hour, 1 minute and 1 second'
+
     ```
     """
+    import datetime as dt
+
+    if isinstance(value, dt.timedelta):
+        negative = value < dt.timedelta(0)
+    else:
+        negative = isinstance(value, (int, float)) and value < 0
+    if negative:
+        value = abs(value)
+    result = _precisedelta(value, minimum_unit, suppress, format)
+    # A value that renders as zero (e.g. -1 second with minimum_unit="minutes")
+    # never gains a sign.
+    if negative and any(c in result for c in "123456789"):
+        return "-" + result
+    return result
+
+
+def _precisedelta(
+    value: dt.timedelta | float | None,
+    minimum_unit: str,
+    suppress: Iterable[str],
+    format: str,
+) -> str:
     date, delta = _date_and_delta(value, precise=True)
     if date is None:
         return str(value)
