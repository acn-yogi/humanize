     )
 
 
+@pytest.mark.parametrize(
+    "val, min_unit, suppress, fmt",
+    [
+        (dt.timedelta(seconds=3661), "seconds", [], "%0.2f"),
+        (3661, "seconds", [], "%0.2f"),
+        (dt.timedelta(days=2, seconds=33, microseconds=123000), "seconds", [], "%0.4f"),
+        (
+            dt.timedelta(days=2, seconds=33, microseconds=123),
+            "microseconds",
+            [],
+            "%0.2f",
+        ),
+        (dt.timedelta(hours=49, seconds=30), "seconds", ["days"], "%0.2f"),
+        (90.5, "minutes", [], "%0.2f"),
+        (0.1, "minutes", [], "%0.2f"),
+        (dt.timedelta(days=800), "seconds", ["years", "months"], "%0.2f"),
+    ],
+)
+def test_precisedelta_negative_keeps_sign(
+    val: dt.timedelta | float, min_unit: str, suppress: list[str], fmt: str
+) -> None:
+    neg = -val
+    kwargs = {"minimum_unit": min_unit, "suppress": suppress, "format": fmt}
+    assert humanize.precisedelta(neg, **kwargs) == "-" + humanize.precisedelta(
+        val, **kwargs
+    )
+
+
+@pytest.mark.parametrize("val", [0, 0.0, -0.0, dt.timedelta(0), -dt.timedelta(0)])
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float) -> None:
+    assert humanize.precisedelta(val) == "0 seconds"
+
+
