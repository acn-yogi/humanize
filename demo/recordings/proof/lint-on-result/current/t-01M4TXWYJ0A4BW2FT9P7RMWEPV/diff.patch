diff --git a/tests/test_time.py b/tests/test_time.py
index 887a3fc..bad8662 100644
--- a/tests/test_time.py
+++ b/tests/test_time.py
@@ -838,6 +838,34 @@ def test_precisedelta_suppress_units(
     )
 
 
+@pytest.mark.parametrize(
+    "val, min_unit, suppress, fmt",
+    [
+        (dt.timedelta(seconds=3661), "seconds", [], "%0.2f"),
+        (-3661, "seconds", [], "%0.2f"),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), "seconds", [], "%0.2f"),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), "microseconds", [], "%0.2f"),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), "seconds", ["days"], "%0.4f"),
+        (dt.timedelta(seconds=90, microseconds=100), "seconds", ["seconds"], "%d"),
+        (dt.timedelta(days=800), "days", [], "%0.2f"),
+        (-1.5, "seconds", [], "%0.2f"),
+    ],
+)
+def test_precisedelta_negative_keeps_sign(
+    val: dt.timedelta | float, min_unit: str, suppress: list[str], fmt: str
+) -> None:
+    kwargs = {"minimum_unit": min_unit, "suppress": suppress, "format": fmt}
+    positive = abs(val)
+    expected = "-" + humanize.precisedelta(positive, **kwargs)
+    assert humanize.precisedelta(-positive, **kwargs) == expected
+    assert humanize.precisedelta(-3661) == "-1 hour, 1 minute and 1 second"
+
+
+@pytest.mark.parametrize("val", [0, 0.0, dt.timedelta(0), dt.timedelta(seconds=-0.1)])
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float) -> None:
+    assert humanize.precisedelta(val, minimum_unit="minutes") == "0 minutes"
+
+
 def test_precisedelta_bogus_call() -> None:
