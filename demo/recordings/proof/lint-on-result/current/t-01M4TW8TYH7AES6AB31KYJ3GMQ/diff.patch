+@pytest.mark.parametrize(
+    "val, kwargs",
+    [
+        (dt.timedelta(seconds=3661), {}),
+        (3661, {}),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), {}),
+        (dt.timedelta(microseconds=1001), {"minimum_unit": "microseconds"}),
+        (dt.timedelta(seconds=90), {"suppress": ["seconds", "minutes"]}),
+        (dt.timedelta(days=400), {"minimum_unit": "days", "suppress": ["years"]}),
+        (dt.timedelta(seconds=1, microseconds=230000), {"format": "%0.4f"}),
+        (1.5, {"minimum_unit": "milliseconds"}),
+    ],
+)
+def test_precisedelta_negative(val: dt.timedelta | float, kwargs: dict) -> None:
+    neg = -val
+    assert humanize.precisedelta(neg, **kwargs) == "-" + humanize.precisedelta(
+        val, **kwargs
+    )
+
+
+@pytest.mark.parametrize(
+    "val, kwargs",
+    [
+        (dt.timedelta(0), {}),
+        (0, {}),
+        (-0.0, {}),
+        (dt.timedelta(seconds=-0.1), {"minimum_unit": "minutes"}),
+    ],
+)
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float, kwargs: dict) -> None:
+    assert not humanize.precisedelta(val, **kwargs).startswith("-")
+
