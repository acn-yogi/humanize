diff --git a/tests/test_time.py b/tests/test_time.py
index 887a3fc..6c4edd0 100644
--- a/tests/test_time.py
+++ b/tests/test_time.py
@@ -838,6 +838,32 @@ def test_precisedelta_suppress_units(
     )
 
 
+@pytest.mark.parametrize(
+    "val, min_unit, suppress, fmt",
+    [
+        (dt.timedelta(seconds=3661), "seconds", [], "%0.2f"),
+        (3661, "seconds", [], "%0.2f"),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), "seconds", [], "%0.2f"),
+        (dt.timedelta(seconds=90, microseconds=100), "microseconds", [], "%0.2f"),
+        (dt.timedelta(days=400), "seconds", ["years", "months"], "%0.2f"),
+        (dt.timedelta(seconds=90), "minutes", [], "%0.4f"),
+        (0.5, "milliseconds", [], "%d"),
+    ],
+)
+def test_precisedelta_negative(
+    val: dt.timedelta | float, min_unit: str, suppress: list[str], fmt: str
+) -> None:
+    kwargs = {"minimum_unit": min_unit, "suppress": suppress, "format": fmt}
+    positive = humanize.precisedelta(val, **kwargs)
+    assert humanize.precisedelta(-val, **kwargs) == "-" + positive
+
+
+@pytest.mark.parametrize("val", [0, 0.0, dt.timedelta(0)])
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float) -> None:
+    assert humanize.precisedelta(val) == "0 seconds"
+    assert humanize.precisedelta(-val) == "0 seconds"
+
+
 def test_precisedelta_bogus_call() -> None:
