diff --git a/tests/test_time.py b/tests/test_time.py
index 887a3fc..6f8b28d 100644
--- a/tests/test_time.py
+++ b/tests/test_time.py
@@ -838,6 +838,42 @@ def test_precisedelta_suppress_units(
     )
 
 
+@pytest.mark.parametrize(
+    "val, kwargs",
+    [
+        (dt.timedelta(seconds=3661), {}),
+        (3661, {}),
+        (dt.timedelta(days=2, seconds=3633, microseconds=123000), {}),
+        (dt.timedelta(days=800), {"minimum_unit": "days"}),
+        (dt.timedelta(seconds=90, microseconds=100), {"minimum_unit": "microseconds"}),
+        (dt.timedelta(hours=4, seconds=30), {"suppress": ["hours"]}),
+        (dt.timedelta(seconds=90), {"suppress": ["seconds"], "format": "%0.4f"}),
+        (1.5, {"minimum_unit": "milliseconds"}),
+    ],
+)
+def test_precisedelta_negative_keeps_sign(
+    val: dt.timedelta | float, kwargs: dict[str, typing.Any]
+) -> None:
+    positive = humanize.precisedelta(val, **kwargs)
+    assert humanize.precisedelta(-val, **kwargs) == "-" + positive
+    assert not positive.startswith("-")
+
+
+def test_precisedelta_negative_example() -> None:
+    assert (
+        humanize.precisedelta(dt.timedelta(seconds=-3661))
+        == "-1 hour, 1 minute and 1 second"
+    )
+
+
+@pytest.mark.parametrize("val", [0, -0.0, dt.timedelta(0)])
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float) -> None:
+    assert humanize.precisedelta(val) == "0 seconds"
+    assert humanize.precisedelta(-dt.timedelta(seconds=0.1), minimum_unit="minutes") == (
+        "0 minutes"
+    )
+
+
 def test_precisedelta_bogus_call() -> None:
     assert humanize.precisedelta(None) == "None"
 
