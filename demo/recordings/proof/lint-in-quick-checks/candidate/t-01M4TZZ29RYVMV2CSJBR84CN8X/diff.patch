--- a/tests/test_time.py
+++ b/tests/test_time.py
@@ -838,6 +838,46 @@ def test_precisedelta_suppress_units(
     )
 
 
+@pytest.mark.parametrize(
+    "val, min_unit, suppress, fmt",
+    [
+        (dt.timedelta(seconds=3661), "seconds", [], "%0.2f"),
+        (3661, "seconds", [], "%0.2f"),
+        (
+            dt.timedelta(days=2, seconds=3633, microseconds=123000),
+            "seconds",
+            [],
+            "%0.2f",
+        ),
+        (
+            dt.timedelta(days=2, seconds=3633, microseconds=123000),
+            "microseconds",
+            [],
+            "%0.4f",
+        ),
+        (dt.timedelta(days=400), "seconds", ["years"], "%0.2f"),
+        (dt.timedelta(hours=4, seconds=30), "seconds", ["hours"], "%0.2f"),
+        (90.5, "minutes", [], "%0.3f"),
+    ],
+)
+def test_precisedelta_negative_keeps_sign(
+    val: dt.timedelta | float, min_unit: str, suppress: list[str], fmt: str
+) -> None:
+    neg = -val
+    positive = humanize.precisedelta(
+        val, minimum_unit=min_unit, suppress=suppress, format=fmt
+    )
+    assert (
+        humanize.precisedelta(neg, minimum_unit=min_unit, suppress=suppress, format=fmt)
+        == "-" + positive
+    )
+
+
+@pytest.mark.parametrize("val", [0, dt.timedelta(0), -0.0, dt.timedelta(seconds=-0.1)])
+def test_precisedelta_zero_has_no_sign(val: dt.timedelta | float) -> None:
+    assert humanize.precisedelta(val, minimum_unit="minutes") == "0 minutes"
+
+
